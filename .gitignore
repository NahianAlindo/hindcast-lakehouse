# Python
__pycache__/
*.py[cod]
.venv/
.venv*/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Secrets — never committed, always Key Vault / GitHub Secrets
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
tfplan
crash.log

# dbt
warehouse/dbt/**/target/
warehouse/dbt/**/dbt_packages/
warehouse/dbt/**/logs/
warehouse/dbt/**/*.duckdb
warehouse/dbt/**/*.duckdb.wal
warehouse/dbt/**/.user.yml

# Restore-a-data-version output (docs/runbooks/restore-a-data-version.md,
# warehouse/dvc/load_exports_into_duckdb.py) -- a local scratch artifact,
# regenerated on demand from a DVC-pulled snapshot, same reasoning as the
# dbt-produced *.duckdb files above.
/hindcast_restored.duckdb

# Data — tracked via DVC pointers, not git. The *.dvc pointer files
# themselves are small metadata and belong in git (that's the whole
# mechanism); only the real content they point at needs excluding, and DVC
# already manages that narrower exclusion itself at `dvc add`/`dvc repro`
# time (see e.g. data/exports/.gitignore once that stage has run once).
data/*
!data/.gitkeep
!data/**/*.dvc
*.parquet
*.jsonl.gz

# DVC
/.dvc/cache
/.dvc/tmp

# Airflow
orchestration/airflow/logs/
*.sqlite3

# Docker / OS / IDE
.DS_Store
Thumbs.db
*.log

# Claude Code local machine settings (not shared)
.claude/settings.local.json
