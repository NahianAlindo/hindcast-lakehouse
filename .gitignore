# Python
__pycache__/
*.py[cod]
.venv/
.venv*/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Secrets — never committed, always Key Vault / GitHub Secrets
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log

# dbt
warehouse/dbt/**/target/
warehouse/dbt/**/dbt_packages/
warehouse/dbt/**/logs/

# Data — tracked via DVC pointers, not git
data/*
!data/.gitkeep
*.parquet
*.jsonl.gz

# EXCEPTION, interim only: data/bronze/ IS committed directly until Phase 1
# provisions Azure ADLS Gen2. GitHub Actions runners (accrual-fallback.yml)
# are ephemeral, so git is the only durable store available before then.
# Remove this exception once ingestion writes to ADLS instead.
!data/bronze/
!data/bronze/**

# DVC
/.dvc/cache
/.dvc/tmp

# Airflow
orchestration/airflow/logs/
*.sqlite3

# Docker / OS / IDE
.DS_Store
Thumbs.db
*.log

# Claude Code local machine settings (not shared)
.claude/settings.local.json
