# Copy this file to .env (already git-ignored) and fill in real values.
# .env is a Phase-0 stopgap only — this moves into Azure Key Vault once
# infra/terraform provisions it in Phase 1 (see docs/PLAN.md §5 Phase 1).

# OpenWeatherMap — Classic free tier only. No card, no expiry, no OAuth.
# Get a key at home.openweathermap.org/api_keys. Do NOT subscribe to One Call
# API 3.0/4.0 — see docs/PLAN.md §2 decision #2 for why that's excluded.
OWM_API_KEY=
OWM_BASE_URL=https://api.openweathermap.org
